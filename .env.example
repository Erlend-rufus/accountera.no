# Kopier til .env for lokal kjøring med `netlify dev`. Ingen av verdiene skal inn i repoet.
# I produksjon settes de som miljøvariabler i Netlify (Site settings → Environment variables).

# --- Klient (bygges inn i nettleserbundelen, prefiks VITE_) ---
# Calendly-lenken til Marius' 30-minutters samtale. Tom verdi: takkesiden viser telefon-fallback.
VITE_CALENDLY_URL=
# Meta pixel-ID. Tom verdi: ingen pixel lastes, uansett samtykke.
VITE_META_PIXEL_ID=
# Foto-modus i hero: sti til bildet i public/, f.eks. /hero.jpg. Tom verdi viser mønsteret. Skal være tom til det finnes bilder.
VITE_HERO_PHOTO=
# Sitat i bevis-seksjonen. Tom verdi: feltet rendres ikke. Format: tekst|navn, rolle
VITE_QUOTE=

# --- Funksjoner (kun på server) ---
# ClickUp API-token (personlig token eller OAuth). Brukes av /api/lead.
CLICKUP_TOKEN=
# Zapier Catch Hook-URL. Mottar alle felt pluss taskId, taskUrl, utfall, verifisert.
ZAPIER_HOOK_URL=
# Meta Conversions API. Begge må være satt for at CAPI-hendelsen skal sendes.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Valgfritt: Metas test-event-kode for å se CAPI-hendelser i Test Events.
META_TEST_EVENT_CODE=
# Enkel nøkkel for /api/stats (send som ?key= eller header x-stats-key).
STATS_KEY=
# Valgfritt: overstyr ClickUp-liste og space (standard er listen «Accountera – leads»).
CLICKUP_LIST_ID=901525768674
CLICKUP_SPACE_ID=90154749971
# Valgfritt: offentlig URL til siden, brukes som event_source_url mot Meta hvis Origin mangler.
SITE_URL=
