# Kopier til .env for lokal kjøring med `netlify dev`. Ingen av verdiene skal inn i repoet.
# I produksjon settes de som miljøvariabler i Netlify (Site settings → Environment variables).

# --- Klient (bygges inn i nettleserbundelen, prefiks VITE_) ---
# Calendly-lenken, tilbudt bak en lenke på takkesiden (ikke hovedveien, se design-handoff «Ring meg
# opp», 8. oktober 2026, AO-6). Tom verdi: takkesiden viser telefon-fallback i stedet.
VITE_CALENDLY_URL=
# Meta pixel-ID. Tom verdi: ingen pixel lastes, uansett samtykke.
VITE_META_PIXEL_ID=
# Foto-modus i hero: sti til bildet i public/, f.eks. /hero.jpg. Tom verdi viser mønsteret. Skal være tom til det finnes bilder.
VITE_HERO_PHOTO=
# «true» for å ta hero-variant A tilbake i rotasjon. Standard «false»/tom: ?v=a faller tilbake til
# variant C. Se tillegg til byggebrief 08, 5. september 2026.
VITE_HERO_A_ENABLED=
# «true» når Accountera har godkjent personvernteksten. Tom/annen verdi: utkast-varselet vises øverst på /personvern.
VITE_PRIVACY_APPROVED=
# «true» når det foreligger skriftlig «ja» fra kunden bak sitatet ved skjemaet (teksten ligger i
# src/content/site.ts, ikke her). Standard «false», manuell bryter. Se tillegg til byggebrief 08.
VITE_QUOTE_APPROVED=
# «true» for å vise linjen «Sender du inn kveld eller helg, ringer vi neste virkedag.» under hero-
# knappen og skjema-knappen. Standard «false»/tom (AO-5, design-handoff «Ring meg opp»).
VITE_WEEKEND_EVENING_BANNER=

# --- Funksjoner (kun på server) ---
# ClickUp API-token (personlig token eller OAuth). Brukes av /api/lead. Sekundært verktøy siden
# 5. september 2026 (lead-registeret er Google Sheet via ZAPIER_HOOK_URL), ikke kritisk. Mangler
# den, opprettes ingen task, men innsendingen går likevel gjennom.
CLICKUP_TOKEN=
# Zapier Catch Hook-URL, steg 1: oppretter raden i Google Sheet-registeret, se README «Funksjonen
# /api/lead». Kritisk: /api/lead prøver på nytt én gang ved feil, og total feil logges på «error»-nivå.
ZAPIER_HOOK_URL=
# Zapier Catch Hook-URL, steg 2 (PATCH /api/lead/:leadId): finner raden fra steg 1 på leadId og
# fyller inn har/program/melding. Skal aldri opprette en ny rad. Mangler den, logges det på
# «warn»-nivå, men den besøkende ser ingenting av det (AO-3).
ZAPIER_HOOK_URL_STEP2=
# Meta Conversions API. Begge må være satt for at CAPI-hendelsen skal sendes.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Valgfritt: Metas test-event-kode for å se CAPI-hendelser i Test Events.
META_TEST_EVENT_CODE=
# Enkel nøkkel for /api/stats (send som ?key= eller header x-stats-key).
STATS_KEY=
# Valgfritt: overstyr ClickUp-liste og space (standard er listen «Accountera – leads»).
CLICKUP_LIST_ID=901525768674
CLICKUP_SPACE_ID=90154749971
# Valgfritt: offentlig URL til siden, brukes som event_source_url mot Meta hvis Origin mangler.
SITE_URL=
